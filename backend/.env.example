# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# xAI Grok API
GROK_API_KEY=
GROK_MODEL=grok-3

# Railway Postgres
# Use the public URL for local dev; Railway injects the internal URL automatically in production
DATABASE_URL=

# Cloudflare R2 (PDF storage)
# Account ID: found on R2 overview page in Cloudflare dashboard
# Access Key ID + Secret: from R2 API Token (shown once at creation)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=disclosure-pdfs
R2_ENDPOINT_URL=https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Complaint HMAC signing secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COMPLAINT_HMAC_SECRET=

# CORS — comma-separated list of allowed origins
# Local dev: http://localhost:3000
# Production: add your Vercel domain after first deploy
ALLOWED_ORIGINS=http://localhost:3000

# Socrata App Token (optional — increases rate limits)
# Register free at: https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=
